# Use an existing dataset in a Sanity project created for BUTTERFLY.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=
# Optional server-side read-only token for the public experience when anonymous reads are unavailable.
SANITY_API_READ_TOKEN=
# Optional server/CLI write token. The Sanity CLI session also works for local scripts.
SANITY_API_TOKEN=
